{
    "name": "@dloizides/ui-email-center",
    "version": "0.1.0",
    "description": "Shared, brand-agnostic React Native (RN-web) 'Email Center' surface for the dloizides.com portfolio: a per-product registry of every transactional email a product sends, organized by an extensible business taxonomy, with per-tenant/per-event copy customization, dynamic-field ({{token}}) preview, and pluggable save/send-status ports. Built on @dloizides/ui-feedback|forms|buttons.",
    "keywords": [
        "react",
        "react-native",
        "react-native-web",
        "ui",
        "email",
        "email-templates",
        "transactional-email",
        "preview",
        "dloizides"
    ],
    "author": "dloizides",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/openmindednewby/ui-email-center.git"
    },
    "homepage": "https://github.com/openmindednewby/ui-email-center#readme",
    "bugs": {
        "url": "https://github.com/openmindednewby/ui-email-center/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "react-native": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "browser": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "default": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "ADOPTION.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "rimraf dist && tsup",
        "build:watch": "tsup --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist",
        "security:audit": "npm audit --audit-level=high",
        "prepublishOnly": "npm run clean && npm run build && npm run test"
    },
    "peerDependencies": {
        "@dloizides/ui-buttons": ">=1.4.0",
        "@dloizides/ui-feedback": ">=1.1.0",
        "@dloizides/ui-forms": ">=1.8.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-native": ">=0.74.0"
    },
    "peerDependenciesMeta": {
        "react-dom": {
            "optional": true
        }
    },
    "devDependencies": {
        "@dloizides/ui-buttons": "^1.8.0",
        "@dloizides/ui-feedback": "^1.8.0",
        "@dloizides/ui-forms": "^1.12.0",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.19.32",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-native": "0.81.5",
        "react-native-web": "^0.21.0",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.1.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    }
}
